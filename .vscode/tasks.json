{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "DoodleGo: Frontend",
			"type": "shell",
			"command": "frontend\\node_modules\\.bin\\vite.cmd",
			"args": [
				"--host",
				"0.0.0.0",
				"--port",
				"5174"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "DoodleGo: Backend",
			"type": "shell",
			"command": "go",
			"args": ["run", "."],
			"options": {
				"cwd": "${workspaceFolder}/backend"
			},
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}